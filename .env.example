# TDR environment variables. Copy to .env (git-ignored) and fill in for local
# dev. Production deploys set the same names through the platform's secret
# store, not via a committed file.

# Prisma SQLite file used by `npm run dev` / `npm run setup`. The npm scripts
# already default this to file:./dev.db; only set it here to point at a
# different DB during tests or ephemeral environments.
DATABASE_URL=file:./dev.db

# Identity fallback for the slice before real auth (issue #21/23). When no
# session cookie is present, `getCurrentLearnerId()` returns this value.
# Override per-server (e.g. a second `next dev` for the two-learner
# isolation spec) by spawning with `CURRENT_LEARNER_ID=bob npm run dev`.
CURRENT_LEARNER_ID=demo-learner

# Secret used to sign session cookies (issue #23). Auto-generated on first
# dev run into .tdr-session-secret (git-ignored). Set explicitly for
# reproducible tests or to mirror a value across multiple server processes.
# TDR_SESSION_SECRET=

# Kody Brand Chat delegated-client contract (issue #23).
# Local dev defaults: issuer is http://localhost:3000, audience is the
# production Kody deployment. Production must override the issuer with the
# HTTPS origin that also serves /.well-known/jwks.json so Kody can fetch
# the public key over TLS.
KODY_CLIENT_IDENTITY_ISSUER=http://localhost:3000
KODY_CLIENT_IDENTITY_AUDIENCE=https://kody.dev
KODY_EXTERNAL_LAUNCH_URL=https://kody.dev/api/client-session/external-launch
KODY_TENANT_OWNER=aharonyaircohen
KODY_TENANT_REPO=tdr
KODY_BRAND_SLUG=tdr-default

# Set to "true" in tests / local dev to allow the e2e suite to wipe
# Message + Progress rows between scenarios via /api/dev/reset.
ALLOW_DEV_RESET=true